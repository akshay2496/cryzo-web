# Public URL of this landing page, without a trailing slash (e.g. https://cryzo.in).
# Needed for canonical URLs, absolute share images (WhatsApp/Facebook/LinkedIn previews),
# sitemap.xml and full structured data. Set it before the production build.
VITE_SITE_URL=

# Optional: Google Search Console "HTML tag" verification code (only the content value).
VITE_GOOGLE_SITE_VERIFICATION=

# URL of the CRYZO POS web app (the `frontend` project). "Login" buttons go to <this>/login.
VITE_POS_APP_URL=http://localhost:5173

# CRYZO backend API base URL (required). Pricing plans come from GET /subscriptions/plans/active
# (managed in the POS app → Subscription Plans) and demo requests go to /public/demo-request.
# In dev, "/api" is proxied to VITE_API_PROXY_TARGET (see vite.config.js).
# In production, add the landing page's domain to the backend's CORS_ORIGINS.
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:5000

# Demo form → email. By default the form posts to {VITE_API_URL}/public/demo-request
# (backend/routes/demoRequest.js), which emails the details to DEMO_NOTIFY_EMAIL in the backend .env.
# Set this only to override that URL. If the request fails, the form falls back to WhatsApp / email.
VITE_DEMO_API_URL=
